# ---------------------------------------------------------------------------
# Creative SEO — environment reference (copy to .env and fill in).
# See DEPLOYMENT.md for the full variable reference.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
WORKER_PORT=3100
LOG_LEVEL=info
API_PUBLIC_URL=https://app.yourdomain.com
CORS_ORIGINS=https://app.yourdomain.com
WEB_ORIGIN=https://app.yourdomain.com

# --- Database / Redis ---
DATABASE_URL=postgres://creative_seo:CHANGE_ME@127.0.0.1:5432/creative_seo
REDIS_URL=redis://127.0.0.1:6379

# --- Secrets (generate: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=change-me-access-secret-0000000000000000
JWT_REFRESH_SECRET=change-me-refresh-secret-0000000000000000
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_SECURE=true

# --- Rate limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=300
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=10

# --- AI providers ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_DEFAULT_MODEL=sonar-pro
AI_DEFAULT_PROVIDER=OPENAI
AI_DEFAULT_MODEL=gpt-4o-mini
AI_FALLBACK_PROVIDERS=ANTHROPIC,PERPLEXITY
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_MS=1000

# --- Google Search Console (OAuth) ---
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=https://app.yourdomain.com/api/sites/:siteId/gsc/callback

# --- WordPress connector ---
WP_REQUEST_TIMEOUT_MS=15000
WP_ALLOW_PRIVATE_ADDRESSES=false

# --- White-label reporting ---
AGENCY_NAME=Creative SEO
AGENCY_LOGO_URL=
AGENCY_EMAIL=
AGENCY_PHONE=
AGENCY_FOOTER=
REPORTS_DIR=./data/reports

# --- n8n orchestration (empty disables dispatch) ---
N8N_BASE_URL=
N8N_WEBHOOK_BASE=
N8N_CALLBACK_SECRET=
N8N_WEBHOOK_TIMEOUT_MS=10000

# --- Admin seeding (npm run db:seed) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Admin
