# Infrastructure defaults (docker compose). Copy to .env in infra/.
POSTGRES_USER=creative_seo
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=creative_seo

# Generate: openssl rand -hex 32 (JWT secrets) / openssl rand -hex 32 (ENCRYPTION_KEY)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
CORS_ORIGINS=https://localhost
LOG_LEVEL=info
