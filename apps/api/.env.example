# Copy to .env in apps/api. Dev-only defaults; never ship secrets in production.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://creative_seo:creative_seo_dev@127.0.0.1:5432/creative_seo
REDIS_URL=redis://127.0.0.1:6379

# openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
# seconds
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# AES-256-GCM key, 64 hex chars = 32 bytes: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Global + auth rate limits (requests per window)
THROTTLE_TTL=60000
THROTTLE_LIMIT=300
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=10
