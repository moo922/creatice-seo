{
  "name": "@creative-seo/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS REST API — source of truth for the Search & AI Visibility platform",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --runInBand --config jest.unit.json",
    "test:unit": "jest --runInBand --config jest.unit.json",
    "test:e2e": "jest --runInBand --config jest-e2e.json --passWithNoTests",
    "test:scenario": "jest --runInBand --forceExit --config jest-e2e.json --testRegex \"scenario\\.spec\\.ts$\""
  },
  "dependencies": {
    "@creative-seo/ai": "^0.1.0",
    "@creative-seo/config": "^0.1.0",
    "@creative-seo/content": "^0.1.0",
    "@creative-seo/database": "^0.1.0",
    "@creative-seo/links": "^0.1.0",
    "@creative-seo/operations": "^0.1.0",
    "@creative-seo/orchestration": "^0.1.0",
    "@creative-seo/reporting": "^0.1.0",
    "@creative-seo/types": "^0.1.0",
    "@creative-seo/visibility": "^0.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
