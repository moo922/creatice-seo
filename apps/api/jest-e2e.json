{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@creative-seo/types$": "<rootDir>/../../packages/types/src/index.ts",
    "^@creative-seo/config$": "<rootDir>/../../packages/config/src/index.ts",
    "^@creative-seo/database$": "<rootDir>/../../packages/database/src/index.ts"
  }
}
