{
  "name": "creative-seo",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted multi-site Search & AI Visibility platform (agency operating system)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:api": "turbo run dev --filter=@creative-seo/api",
    "dev:web": "turbo run dev --filter=@creative-seo/web",
    "dev:worker": "turbo run dev --filter=@creative-seo/worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run migration:run --workspace=@creative-seo/database",
    "db:seed": "npm run seed --workspace=@creative-seo/database",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "echo 'Restore: gunzip -c data/backups/<file>.sql.gz | psql \"$DATABASE_URL\"'"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "typeorm": "0.3.31"
  }
}
