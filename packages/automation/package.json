    "@creative-seo/keyword-engine": "*",
    "@creative-seo/links": "*",
    "@creative-seo/operations": "*",
    "@creative-seo/reporting": "*",
    "@creative-seo/types": "*",
    "@creative-seo/visibility": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
