    "test": "jest --runInBand --config jest.unit.json"
  },
  "dependencies": {
    "@creative-seo/database": "^0.1.0",
    "@creative-seo/types": "^0.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
